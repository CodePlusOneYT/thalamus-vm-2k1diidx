# Card Drive & Drift - Environment Configuration Template
# Copy this file to .env and modify values as needed

# Development Server Settings
VITE_PORT=3000

# Debug Mode (true/false)
VITE_DEBUG_MODE=false

# Audio System (true/false)
VITE_AUDIO_ENABLED=true

# Maximum FPS Cap (numeric value)
VITE_MAX_FPS=60

# Game Settings (additional optional vars)
VITE_FULLSCREEN=false
VITE_HIGH_QUALITY=false

# Build timestamp (auto-generated)
BUILD_VERSION=1.0.0
BUILD_DATE=2026-08-28