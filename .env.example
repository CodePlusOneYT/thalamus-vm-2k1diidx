# Card Drive & Drift - Environment Configuration Template
# Copy this file to .env and modify values as needed

# Development server port (default: 3000)
VITE_PORT=3000

# Enable debug mode (true/false) - shows extra logging in console
VITE_DEBUG_MODE=false

# Enable audio system (true/false) - prevents autoplay policy issues
VITE_AUDIO_ENABLED=true

# Maximum frames per second for game loop (default: 60)
VITE_MAX_FPS=60