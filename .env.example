# Card Drive & Drift - Environment Configuration Template
# Copy this file to .env and modify values as needed
# DO NOT commit .env to version control

# Game Server Settings
VITE_PORT=3000

# Debug Mode: true enables verbose logging and development features
VITE_DEBUG_MODE=false

# Audio System: true enables sound effects and music
VITE_AUDIO_ENABLED=true

# Maximum Frames Per Second for game loop (recommended: 60 or 144)
VITE_MAX_FPS=60